# OpenAI API Key (required for content generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Anthropic API Key (alternative to OpenAI)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Optional: DataForSEO API credentials (for keyword research)
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password

# Optional: Google Search Console API
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Content Generation Settings
DEFAULT_LANGUAGE=en
MAX_ARTICLE_WORDS=2500
INCLUDE_IMAGES=true

# Output Settings
OUTPUT_DIR=./output
OUTPUT_FORMAT=markdown
